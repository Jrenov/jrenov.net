---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteNav from "../components/SiteNav.astro";
import site from "../lib/site.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  current?: string;
  ogUrl?: string;
  ogImage?: string;
  ogType?: string;
  twitter?: boolean;
  robots?: string;
  preloadHeaderImage?: boolean;
  showPortrait?: boolean;
  portraitAlt?: string;
  headerBaseline?: string;
  jsonLd?: object[];
  contactHref?: string;
}

const {
  title,
  description,
  canonical,
  current,
  ogUrl = canonical,
  ogImage = "https://jrenov.net/images/header-image.webp",
  ogType = "website",
  twitter = false,
  robots,
  preloadHeaderImage = false,
  showPortrait = true,
  portraitAlt,
  headerBaseline,
  jsonLd = [],
  contactHref = "#contact",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="apple-mobile-web-app-title" content="Jrenov" />
    <title>{title}</title>

    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {preloadHeaderImage && (
      <link rel="preload" as="image" href="/images/header-image.webp" fetchpriority="high" />
    )}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Jrenov" />

    {twitter && (
      <>
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <Header
      baseline={headerBaseline ?? site.headerBaseline}
      portrait={showPortrait}
      portraitAlt={portraitAlt}
    />
    <SiteNav current={current} contactHref={contactHref} />
    <slot name="subnav" />

    <a
      href={`tel:${site.phoneTel}`}
      class="floating-contact-btn"
      aria-label={`Appeler Jrenov au ${site.phoneDisplay}`}
    >
      <span>📞 Appeler</span>
    </a>

    <main>
      <slot />
    </main>

    <Footer />

    <a
      href={`tel:${site.phoneTel}`}
      class="mobile-call-bar"
      aria-label={`Appeler Jrenov au ${site.phoneDisplay}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.74-1.27a2 2 0 0 1 2.11-.45c.74.34 1.53.57 2.34.7A2 2 0 0 1 22 16.92z"/></svg>
      Appeler — {site.phoneDisplay}
    </a>
  </body>
</html>
