---
import { menuPages } from "../lib/pages.ts";

interface Props {
  current?: string;
  contactHref?: string;
}
const { current, contactHref = "#contact" } = Astro.props;

const items = [
  { href: "/", label: "Accueil" },
  { href: "/plombier-vannes", label: "Plombier" },
  { href: "/electricien-vannes", label: "Électricien" },
  { href: "/serrurier-vannes", label: "Serrurier" },
  { href: "/debouchage-canalisation-vannes", label: "Débouchage canalisation" },
  { href: "/renovation-vannes", label: "Rénovation" },
  // Pages créées dans l'admin avec « Lien dans le menu du haut »
  ...menuPages.map((p) => ({ href: `/${p.url}`, label: p.menuLabel?.trim() || p.title })),
  { href: contactHref, label: "Contact" },
];
---

<nav class="site-nav" aria-label="Navigation principale">
  <ul>
    {items.map((it) => (
      <li>
        <a href={it.href} aria-current={current === it.href ? "page" : undefined}>{it.label}</a>
      </li>
    ))}
  </ul>
</nav>
